+-- ═══════════════════════════════════════════════════════════════════
+-- 蓝眼空间数据仓库（hspace）
+--
+-- 思路：物品以「纯数据记录」存在，不占世界实体、不占容器槽位，
+--       容量上限只看存档体积，不看世界里有多少箱子。
+--   序列化闭环  ← components/unwrappable.lua:47-70 / 80-138 / 182-199
+--   独立文件持久化 ← 简易存储 3383078008 / ss_util/persistentdata.lua
+--
+-- 分阶段：
+--   期1（本段）数据层 + 持久化 + 旧容器迁移 + console 验证
+--   期2       假容器（FakeContainer/FakeItem）+ UI 接入
+--   期3       shift+左键 / 右键 / 抓取 / 制作栏伪造 opencontainers
+-- ═══════════════════════════════════════════════════════════════════
+local HSpace = require("hspace/datastore")
+-- ⚠️ 必须在 modmain 执行期间 require 并注册：RPC 注册函数只有在这个阶段调用才有效，
+-- 拖到运行时（比如第一次开面板）再注册，MOD_RPC 已经冻结，包发不出去。
+local HSpaceRPC = require("hspace/rpc")
+
+local _hs_rpc_count = 0
+for name, fn in pairs(HSpaceRPC.ServerHandlers) do
+  AddModRPCHandler("hspace", name, fn)
+  _hs_rpc_count = _hs_rpc_count + 1
+end
+-- ⚠️ server→client 方向也必须在**两端**都调 AddClientModRPCHandler：
+--    它的 id 是「按注册顺序递增」的（networkclientrpc.lua:1851-1864），
+--    服务端不注册就拿不到 id，SendModRPCToClient 会永远失败（日志提示"RPC 未注册"）。
+--    专用服务器上该函数可能不存在，所以判空。
+for name, fn in pairs(HSpaceRPC.ClientHandlers) do
+  if AddClientModRPCHandler ~= nil then
+    AddClientModRPCHandler("hspace", name, fn)
+    _hs_rpc_count = _hs_rpc_count + 1
+  end
+end
+print("[hspace] 已注册 " .. tostring(_hs_rpc_count) .. " 个 RPC 处理函数")
+
+-- 数据化的空间 id（存档命名空间，和 VAULT_THEMES 的 key 对齐）
+-- 期1 只做蓝眼；四色月眼加到这张表即可复用整套逻辑
+local HSPACE_IDS = { "hslot" }
+
+-- ⚠️ 自动迁移：第一次进游戏时把旧的 160 格容器内容搬进数据仓库。
+-- 迁移只做一次（meta.migrated 落盘）。数据搬完旧容器是空的，
+-- 靠 hspace_migrate("hslot", true) 才能重跑。
+local HSPACE_AUTO_MIGRATE = false
+
+-- -------------------------------------------------------------------
+-- tag 备份
+-- 服务端没有枚举实体 tag 的 API（客户端靠 classified），只能 hook
+-- AddTag/RemoveTag 自己记一份。参考简易存储 main/hook.lua:177-191。
+-- ⚠️ 用 `or {}` 而不是直接 `= {}`，避免和别的 mod 互相清空
+-- -------------------------------------------------------------------
+AddGlobalClassPostConstruct("entityscript", "EntityScript", function(self)
+  self.tags_backup = self.tags_backup or {}
+  local _AddTag = self.AddTag
+  function self:AddTag(tag)
+    self.tags_backup[tag] = 1
+    return _AddTag(self, tag)
+  end
+  local _RemoveTag = self.RemoveTag
+  function self:RemoveTag(tag)
+    self.tags_backup[tag] = nil
+    return _RemoveTag(self, tag)
+  end
+end)
+
+-- ⚠️ 前向声明必须放在 AddGamePostInit **之前**：
+-- 那个闭包在下面几行就创建了，Lua 在编译期就要决定 HSpaceMigrate 是 local
+-- 还是全局。声明写在后面的话闭包会编成全局访问，运行时是 nil，迁移静默失败。
+local HSpaceMigrate
+
+-- -------------------------------------------------------------------
+-- 世界启动：载入各库 + 周期兜底刷盘
+-- -------------------------------------------------------------------
+AddGamePostInit(function()
+  if not TheWorld.ismastersim then
+    return
+  end
+
+  for _, id in ipairs(HSPACE_IDS) do
+    local store = HSpace.Get(id)
+    if store ~= nil then
+      store:Load()
+    end
+  end
+
+  -- MarkDirty 已有 5 秒 debounce，这里再兜一层：
+  -- 任何忘了 MarkDirty 的改动路径也不会把数据搁在内存里。
+  TheWorld:DoPeriodicTask(30, function()
+    HSpace.FlushAll()
+  end)
+
+  -- ⭐ 数据回迁：之前迁进记录池的物品，还回真实容器
+  --    （方案从"虚拟数据"改回"160 格真实容器"，池里剩下的东西要物归原处）
+  TheWorld:DoTaskInTime(4, function()
+    local s = HSpace.Get("hslot")
+    if s == nil then
+      return
+    end
+    s:WhenReady(function(store)
+      if store:Count() == 0 then
+        return
+      end
+      local c = TheWorld:GetPocketDimensionContainer("hslot")
+      if c == nil or not c:IsValid() or c.components.container == nil then
+        print("[hspace] 回迁跳过：找不到口袋容器")
+        return
+      end
+      local total = store:Count()
+      local put = 0
+      local guard = 0
+      while store:Count() > 0 and guard < total + 5 do
+        guard = guard + 1
+        local item = store:SpawnRecord(1, nil, nil, nil)
+        if item == nil then
+          break
+        end
+        if c.components.container:GiveItem(item) then
+          put = put + 1
+        else
+          item:Remove()
+          break
+        end
+      end
+      store:Flush()
+      print(string.format("[hspace] 数据回迁完成：%d/%d 件放回容器，余 %d 条",
+        put, total, store:Count()))
+    end)
+  end)
+
+  -- 自动迁移：等世界实体全部加载完再动手（容器是世界加载时从存档重建的）
+  if HSPACE_AUTO_MIGRATE then
+    TheWorld:DoTaskInTime(3, function()
+      if HSpaceMigrate ~= nil then
+        HSpaceMigrate("hslot", false)
+      else
+        print("[hspace] HSpaceMigrate 未定义，自动迁移跳过")
+      end
+    end)
+  end
+end)
+
+-- -------------------------------------------------------------------
+-- 旧 160 格容器 → 数据记录
+-- -------------------------------------------------------------------
+local function HSpacePushToAll(id)
+  if AllPlayers == nil then
+    return
+  end
+  for _, pl in pairs(AllPlayers) do
+    if pl ~= nil and pl:IsValid() then
+      HSpaceRPC.PushSnapshot(pl, id)
+    end
+  end
+end
+
+HSpaceMigrate = function(id, force, _depth)
+  id = id or "hslot"
+  _depth = _depth or 0
+  -- ⚠️ 容器组件是异步初始化的，要重试；但绝不能无上限递归，
+  -- 万一容器永远不初始化就是一个死循环
+  if _depth > 20 then
+    print("[hspace] 容器组件迟迟未就绪，放弃迁移：" .. id)
+    return
+  end
+
+  local store = HSpace.Get(id)
+  if store == nil then
+    print("[hspace] 只能在游戏内服务端执行")
+    return
+  end
+
+  store:WhenReady(function(s)
+    if s.meta.migrated and not force then
+      print("[hspace] " .. id .. " 已迁移过，跳过（第二个参数传 true 可强制重跑）")
+      return
+    end
+
+    local container_inst = TheWorld:GetPocketDimensionContainer(id)
+    if container_inst == nil or not container_inst:IsValid() then
+      -- 新存档 / 从没打开过月眼：容器还没被创建，等玩家第一次打开时再迁
+      print("[hspace] 找不到口袋空间容器，稍后再试：" .. tostring(id))
+      return
+    end
+    if container_inst.components.container == nil then
+      TheWorld:DoTaskInTime(0, function()
+        HSpaceMigrate(id, force, _depth + 1)
+      end)
+      return
+    end
+
+    local before = s:Count()
+    print(string.format("[hspace] 开始迁移 %s：容器现有 %d 格，库里已有 %d 条",
+      id, container_inst.components.container.numslots or 0, before))
+
+    local moved, kept = s:AddContainer(container_inst)
+    s.meta.migrated = true
+    s.meta.migrated_at = GetTime()
+    s:Flush(function()
+      -- ⚠️ 回调拿不到 success（TheFrontEnd 存在时官方不传参），别打印 tostring(ok)
+      print(string.format("[hspace] %s 迁移完成：%d 件入库，%d 件保留，现共 %d 条",
+        id, moved, kept, s:Count()))
+      -- 迁移完立刻把新数据推给所有开着面板的玩家
+      HSpacePushToAll(id)
+    end)
+  end)
+end
+
+if HSPACE_AUTO_MIGRATE then
+  -- 世界加载后容器已经重建好了，但组件可能是异步补的，这里再兜一次
+  AddPrefabPostInit("hslot_container", function(inst)
+    if not TheWorld.ismastersim then
+      return
+    end
+    inst:DoTaskInTime(1, function()
+      HSpaceMigrate("hslot", false)
+    end)
+  end)
+end
+
+-- -------------------------------------------------------------------
+-- Inventory 补充方法：把鼠标上的物品放进目标容器
+-- ⚠️ 官方 Inventory 没有 MoveItemFrom*Active（只有 MoveItemFrom*Slot），
+--    这是简易存储自己挂的钩子，搬过来。
+-- -------------------------------------------------------------------
+AddComponentPostInit("inventory", function(self)
+  function self:MoveItemFromAllOfActive(container)
+    local item = self:GetActiveItem()
+    if item == nil or container == nil then
+      return
+    end
+    local c = container.components ~= nil and container.components.container or nil
+    if c == nil or not c:IsOpenedBy(self.inst) then
+      return
+    end
+    c.currentuser = self.inst
+    if c:CanTakeItemInSlot(item) then
+      self:RemoveItem(item, true)
+      if not c:GiveItem(item, nil, nil, false) then
+        self:GiveActiveItem(item)
+      end
+    end
+    c.currentuser = nil
+  end
+
+  function self:MoveItemFromOneOfActive(container)
+    local item = self:GetActiveItem()
+    if item == nil or container == nil
+      or item.components == nil or item.components.stackable == nil then
+      return
+    end
+    local c = container.components ~= nil and container.components.container or nil
+    if c == nil or not c:IsOpenedBy(self.inst) then
+      return
+    end
+    c.currentuser = self.inst
+    local one = item.components.stackable:Get(1)
+    if one ~= nil then
+      one.prevslot = nil
+      if not c:GiveItem(one) then
+        item.components.stackable:Put(one)
+      end
+    end
+    c.currentuser = nil
+  end
+end)
+
+-- -------------------------------------------------------------------
+-- 面板关闭回调（关闭按钮 / ESC 都走这里）
+-- 后台容器为了「材料识别」还是开着的，所以仍然走原来的 toggle RPC 关掉它，
+-- 并把打开时右移的 containerroot 复位。
+-- -------------------------------------------------------------------
+AddClassPostConstruct("widgets/controls", function(self)
+  function self:CloseHspacePanel(vault_id)
+    print("[hspace][panel] 关闭面板：" .. tostring(vault_id))
+    local pocket = MOD_RPC ~= nil and MOD_RPC["hslot_pocket"] or nil
+    local rpc = pocket ~= nil and pocket["toggle"] or nil
+    if rpc ~= nil then
+      SendModRPCToServer(rpc, vault_id or "hslot")
+    else
+      print("[hspace][panel] 找不到 toggle RPC，容器可能还开着")
+    end
+    if self.containerroot ~= nil then
+      self.containerroot:SetPosition(0, 0)
+    end
+  end
+end)
