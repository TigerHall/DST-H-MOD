+-- -------------------------------------------------------------------
+-- console 验证入口
+--   hspace_status("hslot")      看条数 / 总件数 / 是否已迁移
+--   hspace_migrate("hslot")     手动把旧容器搬进数据仓库
+--   hspace_put(1)               把背包第 1 格存进库
+--   hspace_give(1, 5)           把第 1 条记录取出 5 个丢到脚下
+-- -------------------------------------------------------------------
+GLOBAL.hspace_status = function(id)
+  id = id or "hslot"
+  local store = HSpace.Get(id)
+  if store == nil then
+    print("[hspace] 只能在游戏内服务端执行")
+    return
+  end
+  store:WhenReady(function(s)
+    print(string.format("[hspace] %s：%d 条记录，共 %d 件，migrated=%s，ready=%s，dirty=%s",
+      s.id, s:Count(), s:TotalStack(),
+      tostring(s.meta.migrated), tostring(s.ready), tostring(s.dirty)))
+    for i = 1, math.min(s:Count(), 10) do
+      local rec = s:Get(i)
+      local view = rec.view or {}
+      print(string.format("  #%d %s x%d%s",
+        i, tostring(view.name or rec.prefab),
+        view.stacksize or 1,
+        view.percent ~= nil and string.format(" (%.0f%%)", view.percent * 100) or ""))
+    end
+  end)
+end
+
+GLOBAL.hspace_migrate = HSpaceMigrate
+
+-- ⚠️ console 里 ThePlayer 指向的是**客户端实体**，没有 components。
+-- 服务端玩家实体要从 AllPlayers[userid] 取（单机同样适用）。
+local function HSpaceServerPlayer()
+  if ThePlayer == nil then
+    return nil
+  end
+  local sp = (AllPlayers ~= nil and AllPlayers[ThePlayer.userid]) or nil
+  if sp ~= nil then
+    return sp
+  end
+  return TheWorld.ismastersim and ThePlayer or nil
+end
+
+-- 存物品进数据仓库（期1 验证用）
+-- slot 不传 = 鼠标手持物品，没有就取背包第 1 格；传了 = 取背包第 slot 格
+GLOBAL.hspace_put = function(slot)
+  local store = HSpace.Get("hslot")
+  if store == nil then
+    print("[hspace] 只能在游戏内服务端执行")
+    return
+  end
+  local pl = HSpaceServerPlayer()
+  if pl == nil or pl.components.inventory == nil then
+    print("[hspace] 找不到服务端玩家实体")
+    return
+  end
+  local inv = pl.components.inventory
+  local item = nil
+  if slot ~= nil then
+    item = inv:GetItemInSlot(slot)
+  else
+    item = inv:GetActiveItem() or inv:GetItemInSlot(1)
+  end
+  if item == nil then
+    print("[hspace] 没找到要存的物品（试试 hspace_put(1)）")
+    return
+  end
+  store:WhenReady(function(s)
+    if not item:IsValid() then
+      return
+    end
+    local prefab = item.prefab
+    local n = item.components.stackable ~= nil
+      and item.components.stackable:StackSize() or 1
+    -- 先脱离背包再入库，避免 Remove 时背包槽位状态残留
+    pl.components.inventory:RemoveItem(item, true, false)
+    local index, err = s:AddItem(item)
+    if index == nil then
+      print("[hspace] 入库失败：" .. tostring(err))
+    else
+      print(string.format("[hspace] 已存入 %s x%d → #%d（共 %d 条记录）",
+        prefab, n, index, s:Count()))
+    end
+  end)
+end
+
+GLOBAL.hspace_give = function(index, count)
+  local store = HSpace.Get("hslot")
+  if store == nil then
+    print("[hspace] 只能在游戏内服务端执行")
+    return
+  end
+  store:WhenReady(function(s)
+    local item = s:SpawnRecord(index, nil, count, HSpaceServerPlayer())
+    if item == nil then
+      print("[hspace] 取不出来，index 越界？" .. tostring(index))
+    else
+      print("[hspace] 取出：" .. tostring(item.prefab))
+    end
+  end)
+end
